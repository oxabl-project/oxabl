          "match": "\\.(?=[A-Za-z_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.abl",
          "match": "[-+*/]="
        },
        {
          "name": "keyword.operator.comparison.abl",
          "match": "<>|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.abl",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.abl",
          "match": "[-+*/]"
        },
        {
          "name": "keyword.operator.abl",
          "match": "[@^]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.abl",
          "match": "\\.(?=\\s|$)"
        },
        {
          "name": "punctuation.separator.comma.abl",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.abl",
          "match": ":"
        },
        {
          "name": "punctuation.section.parens.begin.abl",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.abl",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.abl",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.abl",
          "match": "\\]"
        },
        {
          "include": "#line-continuation"
        }
      ]
    }
  }
}
