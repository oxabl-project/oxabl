<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <!-- Only resolves the jars of Riverside's Proparse; compare.sh compiles RiversideBench.java. -->
  <groupId>org.oxabl.bench</groupId>
  <artifactId>riverside-proparse-bench</artifactId>
  <version>1</version>
  <properties>
    <proparse.version>3.11.1</proparse.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>eu.rssw.openedge.parsers</groupId>
      <artifactId>proparse</artifactId>
      <version>${proparse.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.rssw.openedge.parsers</groupId>
      <artifactId>database-parser</artifactId>
      <version>${proparse.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.rssw.openedge.checks</groupId>
      <artifactId>openedge-checks</artifactId>
      <version>${proparse.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.17</version>
    </dependency>
  </dependencies>
</project>
