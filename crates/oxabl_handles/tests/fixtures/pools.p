DEFINE VARIABLE hMain AS HANDLE NO-UNDO.

CREATE WIDGET-POOL.
CREATE QUERY hMain.

PROCEDURE in-file-pool:
    DEFINE VARIABLE hQuery AS HANDLE NO-UNDO.
    CREATE QUERY hQuery.
END PROCEDURE.

PROCEDURE in-named-pool:
    DEFINE VARIABLE hQuery AS HANDLE NO-UNDO.
    CREATE WIDGET-POOL "work".
    CREATE QUERY hQuery IN WIDGET-POOL "work".
    DELETE WIDGET-POOL "work".
END PROCEDURE.

PROCEDURE in-foreign-pool:
    DEFINE VARIABLE hQuery AS HANDLE NO-UNDO.
    CREATE QUERY hQuery IN WIDGET-POOL "elsewhere".
END PROCEDURE.
