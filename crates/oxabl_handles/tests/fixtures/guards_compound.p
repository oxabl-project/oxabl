DEFINE VARIABLE h1 AS HANDLE NO-UNDO.
DEFINE VARIABLE h2 AS HANDLE NO-UNDO.
DEFINE VARIABLE h3 AS HANDLE NO-UNDO.
DEFINE VARIABLE h4 AS HANDLE NO-UNDO.
DEFINE VARIABLE h5 AS HANDLE NO-UNDO.
DEFINE VARIABLE h6 AS HANDLE NO-UNDO.
DEFINE VARIABLE h7 AS HANDLE NO-UNDO.
DEFINE VARIABLE h8 AS HANDLE NO-UNDO.
DEFINE VARIABLE lFlag AS LOGICAL NO-UNDO.

CREATE QUERY h1.
CREATE QUERY h2.
CREATE QUERY h3.
CREATE QUERY h4.
CREATE QUERY h5.
CREATE QUERY h6.
CREATE QUERY h7.
CREATE QUERY h8.

/* VALID-OBJECT guards like VALID-HANDLE. */
IF VALID-OBJECT(h1) THEN DELETE OBJECT h1.
/* The false branch of a conjunction says nothing about the handle. */
IF VALID-HANDLE(h2) AND lFlag THEN DELETE OBJECT h2.
/* Both tests hold for a live handle, so the false branch cannot happen. */
IF h3 <> ? AND VALID-HANDLE(h3) THEN DELETE OBJECT h3.
/* An invalid handle takes the true branch of a disjunction. */
IF NOT VALID-HANDLE(h4) OR lFlag THEN lFlag = TRUE.
ELSE DELETE OBJECT h4.
/* A disjunction with a true test holds for a live handle. */
IF VALID-HANDLE(h5) OR lFlag THEN DELETE OBJECT h5.
IF h6 = ? THEN lFlag = FALSE.
ELSE DELETE OBJECT h6.
/* A test of another handle is no guard. */
IF VALID-HANDLE(h8) THEN DELETE OBJECT h7.
IF VALID-HANDLE(h8) THEN DELETE OBJECT h8.
