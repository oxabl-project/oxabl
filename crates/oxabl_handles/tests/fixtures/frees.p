DEFINE VARIABLE hProc AS HANDLE NO-UNDO.
DEFINE VARIABLE hClosed AS HANDLE NO-UNDO.
DEFINE VARIABLE hWidget AS HANDLE NO-UNDO.

RUN lib.p PERSISTENT SET hProc.
DELETE PROCEDURE hProc.

/* By convention CLOSE makes a persistent procedure delete itself. */
RUN window.w PERSISTENT SET hClosed.
APPLY "CLOSE" TO hClosed.

CREATE EDITOR hWidget.
DELETE WIDGET hWidget.

PROCEDURE persistent-pool:
    DEFINE VARIABLE hQuery AS HANDLE NO-UNDO.
    DEFINE VARIABLE hKept AS HANDLE NO-UNDO.
    CREATE WIDGET-POOL "long" PERSISTENT.
    CREATE QUERY hQuery IN WIDGET-POOL "long".
    CREATE QUERY hKept IN WIDGET-POOL "long".
    DELETE WIDGET-POOL "long".
END PROCEDURE.

PROCEDURE never-deleted-pool:
    DEFINE VARIABLE hQuery AS HANDLE NO-UNDO.
    CREATE WIDGET-POOL "forever" PERSISTENT.
    CREATE QUERY hQuery IN WIDGET-POOL "forever".
END PROCEDURE.
