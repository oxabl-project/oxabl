DEFINE OUTPUT PARAMETER phOut AS HANDLE NO-UNDO.
DEFINE NEW SHARED VARIABLE hShared AS HANDLE NO-UNDO.
DEFINE VARIABLE hMain AS HANDLE NO-UNDO.
DEFINE VARIABLE hArr AS HANDLE NO-UNDO EXTENT 3.
DEFINE VARIABLE h AS HANDLE NO-UNDO.
DEFINE VARIABLE hProc AS HANDLE NO-UNDO.
DEFINE VARIABLE oWrap AS Progress.Lang.Object NO-UNDO.
DEFINE TEMP-TABLE ttHandle NO-UNDO FIELD hField AS HANDLE.

CREATE QUERY phOut.

CREATE QUERY h.
hShared = h.

CREATE QUERY h.
ttHandle.hField = h.

CREATE QUERY hArr.

CREATE QUERY h.
oWrap = NEW Progress.Lang.Object(h).

RUN super.p PERSISTENT SET hProc.
SESSION:ADD-SUPER-PROCEDURE(hProc).

CREATE QUERY h.
RUN take.p (INPUT-OUTPUT h).

CREATE QUERY h.
PUBLISH "handOver" (INPUT h).

CREATE QUERY h.
RUN use.p (INPUT h).

FUNCTION make RETURNS HANDLE ():
    DEFINE VARIABLE hNew AS HANDLE NO-UNDO.
    CREATE QUERY hNew.
    RETURN hNew.
END FUNCTION.

PROCEDURE keep:
    CREATE QUERY hMain.
END PROCEDURE.

PROCEDURE hand-off:
    DEFINE VARIABLE hLocal AS HANDLE NO-UNDO.
    CREATE BUFFER hLocal FOR TABLE "customer".
    hMain:SET-BUFFERS(hLocal).
    hMain:QUERY-PREPARE("for each customer").
END PROCEDURE.
