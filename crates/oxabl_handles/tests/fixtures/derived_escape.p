DEFINE VARIABLE hLocal AS HANDLE NO-UNDO.

FUNCTION retDefault RETURNS HANDLE ():
    DEFINE VARIABLE hOut AS HANDLE NO-UNDO.
    CREATE TEMP-TABLE hOut.
    RETURN hOut:DEFAULT-BUFFER-HANDLE.
END FUNCTION.

PROCEDURE outBuffer:
    DEFINE OUTPUT PARAMETER phBuf AS HANDLE NO-UNDO.
    DEFINE VARIABLE hTt AS HANDLE NO-UNDO.
    CREATE TEMP-TABLE hTt.
    phBuf = hTt:DEFAULT-BUFFER-HANDLE.
END PROCEDURE.

PROCEDURE retMethod:
    DEFINE VARIABLE hDs AS HANDLE NO-UNDO.
    CREATE DATASET hDs.
    RETURN hDs:GET-BUFFER-HANDLE(1).
END PROCEDURE.

/* A derived handle used locally is a use, not an escape. */
PROCEDURE localUse:
    DEFINE VARIABLE hTt AS HANDLE NO-UNDO.
    DEFINE VARIABLE hBuf AS HANDLE NO-UNDO.
    CREATE TEMP-TABLE hTt.
    hBuf = hTt:DEFAULT-BUFFER-HANDLE.
END PROCEDURE.

/* An attribute that is not a handle is no escape. */
PROCEDURE notHandle:
    DEFINE VARIABLE hQ AS HANDLE NO-UNDO.
    CREATE QUERY hQ.
    RETURN STRING(hQ:NUM-RESULTS).
END PROCEDURE.
