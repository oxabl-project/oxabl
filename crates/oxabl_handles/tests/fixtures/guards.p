DEFINE VARIABLE h1 AS HANDLE NO-UNDO.
DEFINE VARIABLE h2 AS HANDLE NO-UNDO.
DEFINE VARIABLE h3 AS HANDLE NO-UNDO.
DEFINE VARIABLE h4 AS HANDLE NO-UNDO.
DEFINE VARIABLE lFlag AS LOGICAL NO-UNDO.

CREATE QUERY h1.
CREATE QUERY h2.
CREATE QUERY h3.
CREATE QUERY h4.

IF VALID-HANDLE(h1) THEN DELETE OBJECT h1.
IF h2 <> ? THEN DELETE OBJECT h2.
IF NOT VALID-HANDLE(h3) THEN lFlag = TRUE.
ELSE DELETE OBJECT h3.
/* Not a guard: the condition says nothing about h4. */
IF lFlag THEN DELETE OBJECT h4.
