DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
DEFINE VARIABLE hNode AS HANDLE NO-UNDO.
DEFINE VARIABLE hSax AS HANDLE NO-UNDO.
DEFINE VARIABLE hSocket AS HANDLE NO-UNDO.
DEFINE VARIABLE hServer AS HANDLE NO-UNDO.
DEFINE VARIABLE hPrincipal AS HANDLE NO-UNDO.
DEFINE VARIABLE chExcel AS COM-HANDLE NO-UNDO.
DEFINE VARIABLE hAny AS HANDLE NO-UNDO.
DEFINE VARIABLE cType AS CHARACTER NO-UNDO.
DEFINE VARIABLE hArr AS HANDLE NO-UNDO EXTENT 2.
DEFINE TEMP-TABLE ttQuery NO-UNDO FIELD hq AS HANDLE.

CREATE X-DOCUMENT hDoc.
CREATE X-NODEREF hNode IN WIDGET-POOL "xml".
CREATE SAX-READER hSax NO-ERROR.
CREATE SOCKET hSocket.
CREATE SERVER hServer.
CREATE CLIENT-PRINCIPAL hPrincipal.
CREATE "Excel.Application" chExcel.
CREATE VALUE(cType) hAny.
CREATE QUERY hArr[1].
CREATE ttQuery.
CREATE QUERY ttQuery.hq.

DELETE OBJECT hDoc.
DELETE OBJECT hSax.
DELETE OBJECT hSocket.
DELETE OBJECT hServer.
RELEASE OBJECT chExcel.
