CLASS Sample.Holder:
    DEFINE PRIVATE VARIABLE hQuery AS HANDLE NO-UNDO.
    DEFINE PRIVATE VARIABLE hNever AS HANDLE NO-UNDO.

    CONSTRUCTOR PUBLIC Holder():
        CREATE QUERY hQuery.
        CREATE QUERY hNever.
    END CONSTRUCTOR.

    METHOD PUBLIC VOID Work():
        DEFINE VARIABLE hLocal AS HANDLE NO-UNDO.
        CREATE BUFFER hLocal FOR TABLE "customer".
    END METHOD.

    METHOD PUBLIC HANDLE Make():
        DEFINE VARIABLE hNew AS HANDLE NO-UNDO.
        CREATE TEMP-TABLE hNew.
        RETURN hNew.
    END METHOD.

    DESTRUCTOR PUBLIC Holder():
        DELETE OBJECT hQuery NO-ERROR.
    END DESTRUCTOR.
END CLASS.
