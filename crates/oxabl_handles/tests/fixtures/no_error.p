PROCEDURE one:
    DEFINE VARIABLE h1 AS HANDLE NO-UNDO.
    CREATE QUERY h1 NO-ERROR.
    IF ERROR-STATUS:ERROR THEN RETURN.
    DELETE OBJECT h1.
END PROCEDURE.

PROCEDURE two:
    DEFINE VARIABLE h2 AS HANDLE NO-UNDO.
    CREATE BUFFER h2 FOR TABLE "customer" NO-ERROR.
    IF NOT VALID-HANDLE(h2) THEN RETURN.
    DELETE OBJECT h2.
END PROCEDURE.

PROCEDURE three:
    DEFINE VARIABLE h3 AS HANDLE NO-UNDO.
    RUN other.p PERSISTENT SET h3 NO-ERROR.
    IF ERROR-STATUS:ERROR OR NOT VALID-HANDLE(h3) THEN RETURN.
    DELETE PROCEDURE h3.
END PROCEDURE.

/* Not right after the create: a statement between may reset the status. */
PROCEDURE four:
    DEFINE VARIABLE h4 AS HANDLE NO-UNDO.
    DEFINE VARIABLE lFlag AS LOGICAL NO-UNDO.
    CREATE QUERY h4 NO-ERROR.
    lFlag = TRUE.
    IF ERROR-STATUS:ERROR THEN RETURN.
    DELETE OBJECT h4.
END PROCEDURE.

/* Without NO-ERROR the status says nothing about the create. */
PROCEDURE five:
    DEFINE VARIABLE h5 AS HANDLE NO-UNDO.
    CREATE QUERY h5.
    IF ERROR-STATUS:ERROR THEN RETURN.
    DELETE OBJECT h5.
END PROCEDURE.

/* The error branch is the one that cannot hold an object; the other leaks. */
PROCEDURE six:
    DEFINE VARIABLE h6 AS HANDLE NO-UNDO.
    CREATE QUERY h6 NO-ERROR.
    IF NOT ERROR-STATUS:ERROR THEN RETURN.
    DELETE OBJECT h6.
END PROCEDURE.
