DEFINE VARIABLE i AS INTEGER NO-UNDO.
DO ON ERROR UNDO, LEAVE:
    THROW NEW Progress.Lang.AppError("a", 1).
END.
DO ON ERROR UNDO, LEAVE:
    UNDO, THROW NEW Progress.Lang.AppError("b", 1).
END.
DO ON ERROR UNDO, LEAVE:
    IF i = 1 THEN RETURN ERROR "c".
END.
DO ON ERROR UNDO, LEAVE:
    IF i = 2 THEN UNDO, RETURN ERROR "d".
END.
IF i = 0 THEN RETURN ERROR.
