FUNCTION f RETURNS CHARACTER ():
  DEFINE VARIABLE h AS HANDLE NO-UNDO.
  DO ON ERROR UNDO, LEAVE:
    UNDO, RETURN h:PREPARE-STRING.
  END.
  DO ON ERROR UNDO, LEAVE:
    UNDO, RETURN ERROR h:PREPARE-STRING.
  END.
  DO ON ERROR UNDO, LEAVE:
    UNDO, THROW NEW Progress.Lang.AppError(h:PREPARE-STRING, 1).
  END.
  DO ON ERROR UNDO, LEAVE:
    UNDO, RETURN.
  END.
  RETURN "".
END FUNCTION.
