DEFINE VARIABLE i AS INTEGER NO-UNDO.
FUNCTION f RETURNS INTEGER (INPUT p AS INTEGER) FORWARD.
ON CHOOSE OF i DO:
    RETURN NO-APPLY.
END.
ON WRITE OF Customer OLD BUFFER oldCust DO:
    i = 1.
END.
RUN p.
PROCEDURE p:
    i = 2.
END PROCEDURE.
FUNCTION f RETURNS INTEGER (INPUT p AS INTEGER):
    RETURN p + 1.
END FUNCTION.
