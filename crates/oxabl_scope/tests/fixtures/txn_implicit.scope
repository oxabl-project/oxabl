unit u0 main
  b0 main @1 tx=implicit(input @22 OrderLine) buffers=Customer,Item,OrderLine
  b1 for-each @5 tx=implicit(assign @6 Customer) within=b0
  b2 repeat @9 tx=implicit(create @11 Order) within=b0 buffers=Order
  b3 do @10 within=b2
  b4 do @16 tx=implicit(exclusive-lock @17 Item) within=b0
  b5 do @20 within=b0
unit u1 procedure upd
  b0 procedure @25 tx=implicit(delete @27 Customer)
unit u2 procedure copy
  b0 procedure @30 tx=implicit(buffer-copy @34 b2) buffers=b1,b2
buffer b1 defined db:Customer owner=u2 @31 refs=2
  scope u2/b0 free @33 refs=2
buffer b2 defined db:Customer owner=u2 @32 refs=1
  scope u2/b0 free @34 refs=1
buffer Customer default db:Customer owner=u0 refs=4
  scope u0/b0 raised @26 absorbed=@5 refs=4
buffer Order default db:Order owner=u0 refs=1
  scope u0/b2 free @11 refs=1
buffer Item default db:Item owner=u0 refs=1
  scope u0/b0 free @17 refs=1
buffer OrderLine default db:OrderLine owner=u0 refs=2
  scope u0/b0 free @21 refs=2
read for Customer @5 u0/b1 lock=default(share-lock) written
read find Item @17 u0/b4 lock=exclusive-lock
read find OrderLine @21 u0/b5 lock=no-lock written
read find Customer @26 u1/b0 lock=default(share-lock) written
read find b1 @33 u2/b0 lock=no-lock
