unit u0 main
  b0 main @1 buffers=order
  b1 repeat @5 buffers=Customer
  b2 repeat @11 tx=implicit(assign @13 Customer) buffers=Customer
  b3 for-each @18 buffers=Item
buffer Customer default db:Customer owner=u0 refs=4
  scope u0/b1 free @6 refs=2
  scope u0/b2 free @12 refs=2
buffer Item default db:Item owner=u0 refs=2
  scope u0/b3 weak @18 refs=2
buffer order default db:Order owner=u0 refs=1
  scope u0/b0 free @22 refs=1
read find Customer @6 u0/b1 lock=no-lock
read find Customer @12 u0/b2 lock=no-lock written
read for Item @18 u0/b3 lock=no-lock
