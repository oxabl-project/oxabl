unit u0 main
  b0 main @1
  b1 repeat @5 tx=unknown(dynamic-buffer @6)
  b2 for-each @10 tx=unknown(dynamic-buffer @11) buffers=Order
  b3 repeat @14 tx=unknown(skipped-statement @16) buffers=Item
  b4 repeat @19 tx=implicit(assign @21 Customer) buffers=Customer
buffer Order default db:Order owner=u0 refs=2
  scope u0/b2 weak @10 refs=2
buffer Item default db:Item owner=u0 refs=3
  scope u0/b3 free @15 refs=3
buffer Customer default db:Customer owner=u0 refs=2
  scope u0/b4 free @20 refs=2
read for Order @10 u0/b2 lock=no-lock
read find Item @15 u0/b3 lock=no-lock written=unknown(skipped-statement)
read find Customer @20 u0/b4 lock=no-lock written
