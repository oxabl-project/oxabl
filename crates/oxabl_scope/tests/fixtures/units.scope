unit u0 main
  b0 main @1 buffers=bOrder,Customer
  b1 for-each @6
unit u1 procedure uses-default
  b0 procedure @10
  b1 for-each @12 buffers=Item
unit u2 procedure uses-local
  b0 procedure @17 buffers=Customer
unit u3 function f
  b0 function @23
buffer bOrder defined db:Order owner=u0 @4 refs=1
  scope u0/b0 raised @20 refs=1
buffer Customer defined db:Customer owner=u2 @18 refs=1
  scope u2/b0 free @19 refs=1
buffer Customer default db:Customer owner=u0 refs=3
  scope u0/b0 raised @11 absorbed=@6 refs=3
buffer Item default db:Item owner=u0 refs=2
  scope u1/b1 weak @12 refs=2
read for Customer @6 u0/b1 lock=no-lock
read find Customer @11 u1/b0 lock=no-lock
read for Item @12 u1/b1 lock=no-lock
read find Customer @19 u2/b0 lock=no-lock
read find bOrder @20 u2/b0 lock=no-lock
read can-find Item @24 u3/b0 lock=default(share-lock)
