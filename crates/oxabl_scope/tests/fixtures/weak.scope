unit u0 main
  b0 main @1
  b1 for-each @4 buffers=Customer
  b2 for-each @8 buffers=Customer,Order
  b3 repeat @12 buffers=Item
  b4 for-each @14 buffers=OrderLine
buffer Customer default db:Customer owner=u0 refs=5
  scope u0/b1 weak @4 refs=2
  scope u0/b2 weak @8 refs=3
buffer Order default db:Order owner=u0 refs=3
  scope u0/b2 weak @8 refs=3
buffer Item default db:Item owner=u0 refs=2
  scope u0/b3 free @13 refs=2
buffer OrderLine default db:OrderLine owner=u0 refs=2
  scope u0/b4 weak @14 refs=2
read for Customer @4 u0/b1 lock=no-lock
read for Customer @8 u0/b2 lock=no-lock
read for Order @8 u0/b2 lock=no-lock
read find Item @13 u0/b3 lock=no-lock
read for OrderLine @14 u0/b4 lock=no-lock
