unit u0 main
  b0 main @1 tx=unknown(unexpanded-include @3) buffers=Customer,Order
  b1 for-each @5 tx=unknown(unexpanded-include @5) buffers=Item
buffer Customer default db:Customer owner=u0 refs=4
  scope u0/b0 free @3 refs=4
buffer Order default db:Order owner=u0 refs=1
  scope u0/b0 free @4 refs=1
buffer Item default db:Item owner=u0 refs=1
  scope u0/b1 weak @5 refs=1
read find Customer @3 u0/b0 lock=unknown(unexpanded-include)
read find Order @4 u0/b0 lock=no-lock
read for Item @5 u0/b1 lock=unknown(unexpanded-include)
read can-find OrderLine @7 u0/b0 lock=unknown(unexpanded-include)
read find Customer @8 u0/b0 lock=default(share-lock)
