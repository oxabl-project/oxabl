unit u0 main
  b0 main @1 buffers=bTT
  b1 repeat @8 buffers=ttUndo
  b2 for-each @14 buffers=ttNoUndo
buffer bTT defined tt:ttUndo owner=u0 @6 refs=1
  scope u0/b0 free @18 refs=1
buffer ttUndo default tt:ttUndo owner=u0 refs=2
  scope u0/b1 free @9 refs=2
buffer ttNoUndo default tt:ttNoUndo no-undo owner=u0 refs=2
  scope u0/b2 weak @14 refs=2
read for ttNoUndo @14 u0/b2 lock=n/a written
read find bTT @18 u0/b0 lock=n/a
