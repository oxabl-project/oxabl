unit u0 main
  b0 main @1 buffers=Item,Order
  b1 repeat @4 buffers=Customer
  b2 do @6
  b3 do @11 tx=explicit
  b4 do @16
  b5 for-each @20 buffers=Customer,OrderLine
buffer Customer default db:Customer owner=u0 refs=6
  scope u0/b1 free @5 refs=2
  scope u0/b5 free @21 refs=4
buffer Item default db:Item owner=u0 refs=2
  scope u0/b0 free @12 refs=2
buffer Order default db:Order owner=u0 refs=1
  scope u0/b0 free @17 refs=1
buffer OrderLine default db:OrderLine owner=u0 refs=1
  scope u0/b5 weak @20 refs=1
read find Customer @5 u0/b1 lock=no-lock
read find Order @17 u0/b4 lock=no-lock
read for OrderLine @20 u0/b5 lock=no-lock
read find sports.Customer @21 u0/b5 lock=no-lock
