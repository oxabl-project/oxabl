unit u0 main
  b0 main @1 buffers=Order,OrderLine
  b1 do @2 tx=explicit
  b2 for-each @3 tx=implicit(assign @4 Customer) within=b1 buffers=Customer
unit u1 procedure p
  b0 procedure @9
  b1 repeat @10 tx=implicit(create @11 Order)
  b2 repeat @12 tx=implicit(create @13 OrderLine) within=b1
buffer Customer default db:Customer owner=u0 refs=2
  scope u0/b2 weak @3 refs=2
buffer Order default db:Order owner=u0 refs=1
  scope u0/b0 raised @11 refs=1
buffer OrderLine default db:OrderLine owner=u0 refs=1
  scope u0/b0 raised @13 refs=1
read for Customer @3 u0/b2 lock=default(share-lock) written
