unit u0 main
  b0 main @1 buffers=Customer,Order,ttX
  b1 repeat @13 tx=implicit(assign @15 Customer)
  b2 for-each @18 tx=implicit(exclusive-lock @18 Item) buffers=Item
unit u1 procedure passes
  b0 procedure @22 buffers=bItem
buffer bItem defined db:Item owner=u1 @23 refs=2
  scope u1/b0 free @24 refs=2
buffer Customer default db:Customer owner=u0 refs=4
  scope u0/b0 raised @5 absorbed=@14 refs=4
buffer Order default db:Order owner=u0 refs=2
  scope u0/b0 free @6 refs=2
buffer ttX default tt:ttX no-undo owner=u0 refs=1
  scope u0/b0 free @11 refs=1
buffer Item default db:Item owner=u0 refs=2
  scope u0/b2 weak @18 refs=2
read find Customer @5 u0/b0 lock=default(share-lock) written
read find Order @6 u0/b0 lock=no-lock
read can-find OrderLine @7 u0/b0 lock=default(share-lock)
read can-find Item @9 u0/b0 lock=no-lock
read find ttX @11 u0/b0 lock=n/a
read find Customer @14 u0/b1 lock=share-lock written
read for Item @18 u0/b2 lock=exclusive-lock
read find bItem @24 u1/b0 lock=default(share-lock) written=unknown(callee)
