unit u0 main
  b0 main @1 buffers=Customer
  b1 for-each @3
  b2 repeat @9 buffers=Order
  b3 repeat @13 buffers=Order,Item
  b4 for-each @15
buffer Customer default db:Customer owner=u0 refs=3
  scope u0/b0 raised @7 absorbed=@3 refs=3
buffer Order default db:Order owner=u0 refs=2
  scope u0/b2 free @10 refs=1
  scope u0/b3 free @14 refs=1
buffer Item default db:Item owner=u0 refs=2
  scope u0/b3 raised @17 absorbed=@15 refs=2
read for Customer @3 u0/b1 lock=no-lock
read find Customer @7 u0/b0 lock=no-lock
read find Order @10 u0/b2 lock=no-lock
read find Order @14 u0/b3 lock=no-lock
read for Item @15 u0/b4 lock=no-lock
read find Item @17 u0/b3 lock=no-lock
