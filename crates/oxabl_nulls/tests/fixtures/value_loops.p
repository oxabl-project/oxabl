DEFINE INPUT PARAMETER n AS INTEGER NO-UNDO.
DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE INPUT PARAMETER choice AS LOGICAL NO-UNDO.
REPEAT:
  IF n = ? THEN NEXT.
  MESSAGE n + 1.
  LEAVE.
END.
n = ?.
DO i = 1 TO 2 WHILE n <> ?:
  MESSAGE n + 1.
END.
MESSAGE n + 1.
REPEAT WHILE choice:
  n = INTEGER(choice).
  IF choice THEN n = ?.
END.
MESSAGE n + 1.
