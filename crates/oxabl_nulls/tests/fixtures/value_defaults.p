DEFINE VARIABLE d AS DATE NO-UNDO.
DEFINE VARIABLE dt AS DATETIME NO-UNDO.
DEFINE VARIABLE tz AS DATETIME-TZ NO-UNDO.
DEFINE VARIABLE h AS HANDLE NO-UNDO.
DEFINE VARIABLE rid AS ROWID NO-UNDO.
DEFINE VARIABLE rec AS RECID NO-UNDO.
DEFINE VARIABLE obj AS CLASS Progress.Lang.Object NO-UNDO.
DEFINE VARIABLE n AS INTEGER NO-UNDO.
DEFINE VARIABLE c AS CHARACTER NO-UNDO.
DEFINE VARIABLE b AS LOGICAL NO-UNDO.
IF d < TODAY THEN MESSAGE "date".
IF dt > DATETIME(TODAY, 0) THEN MESSAGE "datetime".
IF tz >= NOW THEN MESSAGE "timezone".
IF VALID-HANDLE(h) THEN MESSAGE "handle".
IF rid = ? THEN MESSAGE "rowid".
IF rec = ? THEN MESSAGE "recid".
IF VALID-OBJECT(obj) THEN MESSAGE "object".
MESSAGE n + 1 c + "ok".
IF b THEN MESSAGE "boolean".
