DEFINE VARIABLE n AS INTEGER INITIAL ? NO-UNDO.
DEFINE VARIABLE d AS DATE NO-UNDO.
DEFINE VARIABLE b AS LOGICAL INITIAL ? NO-UNDO.
DEFINE VARIABLE c AS CHARACTER INITIAL ? NO-UNDO.
IF n < 1 THEN MESSAGE "small".
IF n = ? THEN MESSAGE "missing".
IF n <> ? AND n > 0 THEN MESSAGE n + 1.
MESSAGE n + 1.
c = "x" + c.
IF b THEN MESSAGE "yes".
DO WHILE b:
  IF b = ? THEN LEAVE.
  MESSAGE n * 2.
END.
IF d = ? THEN RETURN.
IF d > TODAY THEN MESSAGE "future".
