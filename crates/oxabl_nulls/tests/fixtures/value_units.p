DEFINE VARIABLE outerValue AS INTEGER INITIAL ? NO-UNDO.
PROCEDURE test:
 DEFINE INPUT PARAMETER a AS INTEGER NO-UNDO.
 DEFINE OUTPUT PARAMETER d AS DATE NO-UNDO.
 DEFINE VARIABLE outerValue AS INTEGER NO-UNDO.
 MESSAGE a + 1.
 IF d < TODAY THEN MESSAGE "old".
 MESSAGE outerValue + 1.
 a = ?.
 MESSAGE a + 1.
END PROCEDURE.
MESSAGE outerValue + 1.
