DEFINE INPUT PARAMETER n AS INTEGER NO-UNDO.
DEFINE INPUT PARAMETER other AS INTEGER NO-UNDO.
DEFINE INPUT PARAMETER choice AS LOGICAL NO-UNDO.
DEFINE VARIABLE x AS INTEGER NO-UNDO.
IF choice THEN n = ?.
MESSAGE n + 1.
IF n > 1 THEN MESSAGE "source survives".
x = ? + other.
MESSAGE x + 1.
n = unseen().
MESSAGE n + 1.
