/* A test of the same record or flag on both sides correlates the arms. */
DEFINE TEMP-TABLE tt NO-UNDO FIELD d AS DATE.
DEFINE TEMP-TABLE t2 NO-UNDO FIELD d AS DATE.
DEFINE VARIABLE d AS DATE NO-UNDO.
DEFINE VARIABLE e AS DATE NO-UNDO.
DEFINE VARIABLE g AS DATE NO-UNDO.
DEFINE VARIABLE found AS LOGICAL NO-UNDO.
DEFINE VARIABLE c AS CHARACTER INITIAL ? NO-UNDO.
DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE x AS DATE NO-UNDO.
DEFINE VARIABLE y AS DATE NO-UNDO.
DEFINE INPUT PARAMETER choice AS LOGICAL NO-UNDO.
FIND FIRST tt NO-ERROR.
IF AVAILABLE tt THEN d = tt.d.
IF AVAILABLE tt AND d > TODAY THEN MESSAGE 1.
IF NOT AVAILABLE tt THEN g = TODAY.
ELSE MESSAGE d + 1.
IF AVAILABLE tt THEN e = TODAY.
FIND NEXT tt NO-ERROR.
IF AVAILABLE tt THEN MESSAGE e + 1.
found = FALSE.
IF choice THEN ASSIGN found = TRUE g = TODAY.
IF found THEN MESSAGE g + 1.
found = choice.
IF found THEN MESSAGE g + 1.
DO i = 1 TO NUM-ENTRIES(c):
  MESSAGE c + "x".
END.
MESSAGE c + "x".
FIND FIRST tt NO-ERROR.
FIND FIRST t2 NO-ERROR.
IF AVAILABLE tt THEN x = tt.d.
IF AVAILABLE t2 THEN y = t2.d.
IF (AVAILABLE tt AND NOT AVAILABLE t2) OR (AVAILABLE tt AND x > y) THEN MESSAGE 1.
