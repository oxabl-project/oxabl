/* The call graph (section 8.5). */
DEFINE VARIABLE h AS HANDLE NO-UNDO.
DEFINE VARIABLE h2 AS HANDLE NO-UNDO.
DEFINE VARIABLE hServer AS HANDLE NO-UNDO.
DEFINE VARIABLE x AS INTEGER NO-UNDO.

FUNCTION addOne RETURNS INTEGER (INPUT i AS INTEGER) FORWARD.
FUNCTION remote RETURNS INTEGER (INPUT i AS INTEGER) IN h2.
PROCEDURE ext EXTERNAL "lib.so":
END PROCEDURE.

RUN inner.
RUN other.p (INPUT 1).
RUN lib/svc.p PERSISTENT SET h.
RUN doit IN h.
RUN doit IN h2.
RUN inner IN THIS-PROCEDURE.
RUN VALUE("dyn" + ".p").
RUN ext.
RUN far.p ON SERVER hServer.
x = addOne(1) + remote(2).
x = DYNAMIC-FUNCTION("addOne", 1).
PUBLISH "changed".
h:ADD-SUPER-PROCEDURE(h2).
x = ERROR-STATUS:NUM-MESSAGES.
FOR EACH Customer NO-LOCK:
    RUN inner.
END.

PROCEDURE inner:
    FIND FIRST Customer NO-LOCK NO-ERROR.
    RUN SUPER.
END PROCEDURE.

FUNCTION addOne RETURNS INTEGER (INPUT i AS INTEGER):
    RETURN i + 1.
END FUNCTION.
