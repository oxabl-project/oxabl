{
  "name": "oxabl",
  "displayName": "oxabl — ABL tooling",
  "description": "Progress ABL for VS Code: syntax highlighting, plus format-on-save and live diagnostics from the oxabl language server, driven from oxabl.toml.",
  "version": "0.12.0",
  "publisher": "oxabl-project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxabl-project/oxabl"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Building runs the worker command from oxabl.toml, so no build runs in an untrusted workspace. Highlighting, formatting and diagnostics still work. The settings that name a program or its arguments are not read until you trust the workspace.",
      "restrictedConfigurations": [
        "oxabl.server.path",
        "oxabl.build.args"
      ]
    }
  },
  "activationEvents": [
    "onLanguage:abl",
    "workspaceContains:**/oxabl.toml",
    "onCommand:oxabl.restartServer",
    "onCommand:oxabl.checkForUpdates",
    "onCommand:oxabl.installCli",
    "onCommand:oxabl.installSkill",
    "onCommand:oxabl.build",
    "onCommand:oxabl.selectIncluderContext",
    "onCommand:oxabl.showExpandedUnit",
    "onCommand:oxabl.schema.refresh",
    "onCommand:oxabl.schema.filter",
    "onCommand:oxabl.cancelBuild",
    "onCommand:oxabl.showBuildLog"
  ],
  "contributes": {
    "commands": [
      {
        "command": "oxabl.restartServer",
        "title": "oxabl: Restart Server"
      },
      {
        "command": "oxabl.checkForUpdates",
        "title": "oxabl: Check for Updates"
      },
      {
        "command": "oxabl.installCli",
        "title": "oxabl: Install or Update the CLI"
      },
      {
        "command": "oxabl.installSkill",
        "title": "oxabl: Install agent skill"
      },
      {
        "command": "oxabl.build",
        "title": "oxabl: Build"
      },
      {
        "command": "oxabl.cancelBuild",
        "title": "oxabl: Cancel Build"
      },
      {
        "command": "oxabl.showBuildLog",
        "title": "oxabl: Show Build Log"
      },
      {
        "command": "oxabl.selectIncluderContext",
        "title": "oxabl: Select Include Context"
      },
      {
        "command": "oxabl.showExpandedUnit",
        "title": "oxabl: Show Expanded Compilation Unit"
      },
      {
        "command": "oxabl.schema.refresh",
        "title": "oxabl: Refresh Schema",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "oxabl.schema.filter",
        "title": "oxabl: Filter Schema",
        "shortTitle": "Filter",
        "icon": "$(filter)"
      },
      {
        "command": "oxabl.schema.clearFilter",
        "title": "oxabl: Clear Schema Filter",
        "shortTitle": "Clear Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "oxabl.schema.open",
        "title": "Open in .df",
        "category": "oxabl",
        "icon": "$(go-to-file)"
      },
      {
        "command": "oxabl.schema.copyName",
        "title": "Copy Name",
        "category": "oxabl"
      },
      {
        "command": "oxabl.schema.copyQualifiedName",
        "title": "Copy table.field",
        "category": "oxabl"
      },
      {
        "command": "oxabl.schema.showTable",
        "title": "Show Table Details",
        "category": "oxabl",
        "icon": "$(preview)"
      }
    ],
    "languages": [
      {
        "id": "abl",
        "aliases": [
          "ABL",
          "Progress ABL",
          "OpenEdge ABL"
        ],
        "extensions": [
          ".p",
          ".w",
          ".cls",
          ".i",
          ".v"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "abl",
        "scopeName": "source.abl",
        "path": "./syntaxes/abl.tmLanguage.json"
      },
      {
        "scopeName": "markdown.abl.codeblock",
        "path": "./syntaxes/abl.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.abl": "abl"
        }
      }
    ],
    "configuration": {
      "title": "oxabl",
      "properties": {
        "oxabl.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the oxabl language server (format-on-save and diagnostics). Applied automatically when changed; no window reload needed."
        },
        "oxabl.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the `oxabl` executable. When empty, the extension uses `~/.local/bin/oxabl` (or `$OXABL_INSTALL_DIR/oxabl`), then `oxabl` from your PATH."
        },
        "oxabl.updates": {
          "type": "string",
          "enum": [
            "auto",
            "notify",
            "off"
          ],
          "enumDescriptions": [
            "Check GitHub Releases once a day, then download, verify and install a newer version of the extension and of a managed oxabl CLI. Acts as \"notify\" when VS Code's `extensions.autoUpdate` is false.",
            "Check once a day and ask before installing a newer version of the extension or of a managed oxabl CLI.",
            "Never check by itself. The `oxabl: Check for Updates` command still works."
          ],
          "default": "auto",
          "scope": "application",
          "description": "How the extension updates itself, and the oxabl CLI that it or the installer installed, from GitHub Releases. It is not on the Marketplace, so VS Code does not update it."
        },
        "oxabl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the JSON-RPC communication between VS Code and the oxabl language server (for debugging)."
        },
        "oxabl.build.enable": {
          "type": "boolean",
          "default": true,
          "description": "Build the project with `oxabl build` when it opens and when a file changes. Applied automatically when changed. The commands `oxabl: Build` and `oxabl: Cancel Build` work in either case."
        },
        "oxabl.build.debounce": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "description": "Milliseconds to wait after the last change before a build starts. A build starts at the latest 5 seconds after the first change."
        },
        "oxabl.build.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments for `oxabl build`, for example `[\"--config-overlay\", \"/path/overlay.toml\"]`. Also passed when the extension reads the build setup of a project."
        },
        "oxabl.semanticTokens.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Colour names by what they are, from the language server: a variable, a parameter, a database field, a temp-table field, a buffer, a class, a method and so on. A name that oxabl does not resolve keeps the colour of the grammar. Applied automatically when changed; no window reload needed. VS Code's `editor.semanticHighlighting.enabled` also applies."
        },
        "oxabl.inlayHints.locks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the lock a database read takes when it names none (`SHARE-LOCK`, the default). Shown where `oxabl.toml` turns on the rule `default-lock` (LK001)."
        },
        "oxabl.inlayHints.index": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the index oxabl expects a database search to use, and `WHOLE-INDEX` when no condition brackets it. Needs no strict rule; it shows when `diagnostics` is on in `[workspace.features]`."
        },
        "oxabl.inlayHints.scope": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show where a buffer scope starts and ends when a reference outside a `FOR` block raises it to the procedure (`scope-widened`, TX005). Shown where `oxabl.toml` turns on the rule `scope-widened` (TX005)."
        },
        "oxabl.inlayHints.transactions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show where a transaction starts and ends when a block becomes a transaction only because it updates the database (`implicit-transaction`, TX001, and `procedure-wide-transaction`, TX002). Shown where `oxabl.toml` turns on the rule that reports the block."
        },
        "oxabl.inactiveRegions.enable": {
          "type": "boolean",
          "default": true,
          "description": "Dim the `&IF`, `&ELSEIF` and `&ELSE` branches that the preprocessor does not compile with the current configuration, or in the selected include context. A branch whose condition oxabl cannot decide is never dimmed. Applied automatically when changed."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "table",
        "superType": "type",
        "description": "A table of a database, or the default buffer of one."
      },
      {
        "id": "tempTable",
        "superType": "type",
        "description": "A temp-table."
      },
      {
        "id": "buffer",
        "superType": "variable",
        "description": "A buffer that the code declares."
      },
      {
        "id": "dataset",
        "superType": "type",
        "description": "A dataset."
      },
      {
        "id": "databaseField",
        "superType": "property",
        "description": "A field of a database table."
      },
      {
        "id": "tempTableField",
        "superType": "property",
        "description": "A field of a temp-table."
      }
    ],
    "configurationDefaults": {
      "[abl]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxabl-project.oxabl"
      },
      "evenBetterToml.schema.associations": {
        "**/oxabl.toml": "./schemas/oxabl.schema.json"
      }
    },
    "views": {
      "explorer": [
        {
          "id": "oxabl.schema",
          "name": "ABL Schema",
          "icon": "$(database)",
          "contextualTitle": "oxabl",
          "when": "oxabl.schema.available"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "oxabl.schema.filter",
          "when": "view == oxabl.schema",
          "group": "navigation@1"
        },
        {
          "command": "oxabl.schema.clearFilter",
          "when": "view == oxabl.schema && oxabl.schema.filtered",
          "group": "navigation@2"
        },
        {
          "command": "oxabl.schema.refresh",
          "when": "view == oxabl.schema",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "oxabl.schema.showTable",
          "when": "view == oxabl.schema && viewItem == table",
          "group": "inline"
        },
        {
          "command": "oxabl.schema.showTable",
          "when": "view == oxabl.schema && viewItem =~ /^(table|field|index)$/",
          "group": "1_open@1"
        },
        {
          "command": "oxabl.schema.open",
          "when": "view == oxabl.schema && viewItem =~ /^(database|table|field|index|sequence|problem)$/",
          "group": "1_open@2"
        },
        {
          "command": "oxabl.schema.copyName",
          "when": "view == oxabl.schema && viewItem =~ /^(database|table|field|index|sequence)$/",
          "group": "2_copy@1"
        },
        {
          "command": "oxabl.schema.copyQualifiedName",
          "when": "view == oxabl.schema && viewItem == field",
          "group": "2_copy@2"
        }
      ],
      "commandPalette": [
        {
          "command": "oxabl.schema.open",
          "when": "false"
        },
        {
          "command": "oxabl.schema.copyName",
          "when": "false"
        },
        {
          "command": "oxabl.schema.copyQualifiedName",
          "when": "false"
        },
        {
          "command": "oxabl.schema.showTable",
          "when": "false"
        },
        {
          "command": "oxabl.schema.clearFilter",
          "when": "oxabl.schema.filtered"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "schema": "cargo run -p oxabl -- schema > schemas/oxabl.schema.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:grammar": "vscode-tmgrammar-test \"test/grammar/cases/**/*.p\" && vscode-tmgrammar-snap \"test/grammar/snapshots/**/*.{p,cls,i,w}\"",
    "test:e2e": "node test/e2e/run.mjs",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
