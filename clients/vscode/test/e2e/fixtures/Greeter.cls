USING Progress.Lang.*.

CLASS acme.Greeter:
  DEFINE PUBLIC PROPERTY Greeting AS CHARACTER NO-UNDO GET. SET.

  METHOD PUBLIC VOID Say(INPUT pcName AS CHARACTER):
    DEFINE VARIABLE cMsg AS CHARACTER NO-UNDO.
    cMsg = "Hello, " + pcName + "!".
    MESSAGE cMsg VIEW-AS ALERT-BOX.
  END METHOD.
END CLASS.
