CLASS acme.OutlineDemo:
  DEFINE PUBLIC PROPERTY Title AS CHARACTER NO-UNDO GET. SET.

  CONSTRUCTOR PUBLIC OutlineDemo():
    Title = "demo".
  END CONSTRUCTOR.

  METHOD PUBLIC VOID Render(INPUT pcName AS CHARACTER):
    DEFINE VARIABLE cLine AS CHARACTER NO-UNDO.
    cLine = Title + pcName.
    MESSAGE cLine VIEW-AS ALERT-BOX.
  END METHOD.
END CLASS.
